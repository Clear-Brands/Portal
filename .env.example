# Local Supabase (printed by `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefixed NEXT_PUBLIC_, never imported into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Where sign-in links come back to
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Outbound events (leave blank locally — events queue in event_outbox and are not sent)
GHL_WEBHOOK_URL=
# Shared secret for verifying inbound GHL webhooks
GHL_WEBHOOK_SECRET=

# Transactional email
RESEND_API_KEY=
